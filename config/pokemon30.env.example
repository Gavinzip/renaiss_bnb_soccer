# Copy this file to config/pokemon30.env.local. Keep that local file private.
# The four confirmed PANDORA machines can scan before the limited $100 machine
# is formally issued. That pending machine is excluded from tickets until its
# exact on-chain packId is added; a VRF draw ledger remains blocked meanwhile.

BSCSCAN_API_URL=https://api.etherscan.io/v2/api
BSCSCAN_CHAIN_ID=56
BSCSCAN_API_KEY=
BSCSCAN_RETRIES=5
BSCSCAN_BACKOFF_MS=900
BSCSCAN_REQUEST_TIMEOUT_MS=30000

POKEMON30_BLOCK_CHUNK=4000
POKEMON30_LOG_PAGE_SIZE=1000
POKEMON30_PAYMENT_TOKEN=0x55d398326f99059ff775485246999027b3197955
POKEMON30_CHECKOUT_BUYBACK_LINK_PATH=/secure/pokemon30-checkout-buyback-links.json
POKEMON30_TICKET_LEDGER_PATH=/data/soccer/pokemon30/ticket-ledger.json
# The first run scans from the campaign start. Later runs persist the event cache and
# re-scan from the oldest of the last five successful block checkpoints (10m × 5 = 50m).
POKEMON30_EVENT_CACHE_PATH=/data/soccer/pokemon30/onchain-events.json
POKEMON30_EVENT_CACHE_LOOKBACK_ROUNDS=5
POKEMON30_REFRESH_ENABLED=1
POKEMON30_REFRESH_ON_STARTUP=1
POKEMON30_REFRESH_MINUTES=10
POKEMON30_ALLOW_PENDING_LIMITED_100=1

# The four PANDORA V3 pack IDs below are fixed and checked by the scanner.
# Replace ONLY the empty $100 limited-machine packId after it has been formally issued.
POKEMON30_PACK_RULES_JSON='[{"id":"pandora-28","label":"PANDORA $28","price":"28","packId":"0xcf11308cc7c642554a781b039a63a542c2f20b36f904b5b6981d48a2f76a5f90","lowestTierBbbvMax":"35","buybackPayoutBasisPoints":8500,"ticketWeight":1},{"id":"pandora-48","label":"PANDORA $48","price":"48","packId":"0x4de1e3c158c8630faa2db4e6c5250933188c4990ba30640a44a41eb6732d257d","lowestTierBbbvMax":"60","buybackPayoutBasisPoints":8500,"ticketWeight":2},{"id":"pandora-88","label":"PANDORA $88","price":"88","packId":"0xfe35d4de033fa6ffd14fb4e6a74ffef5ea2fc3ae6666a78d33c4bfb860e056fe","lowestTierBbbvMax":"90","buybackPayoutBasisPoints":8500,"ticketWeight":3},{"id":"pandora-248","label":"PANDORA $248","price":"248","packId":"0x347ba3e1d2875a0e9e09a378369f6105a6a5f3d2a5c0a51b6837da4beb52dd7d","lowestTierBbbvMax":"250","buybackPayoutBasisPoints":8500,"ticketWeight":8},{"id":"limited-100","label":"$100 限定卡機","price":"100","packId":"","lowestTierBbbvMax":"120","buybackPayoutBasisPoints":9000,"ticketWeight":5}]'
